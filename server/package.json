    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "~5.9.2"
  }
}
